{
  "name": "particle-tools-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Particle Tools Studio \u2014 V2 of the editor: a studio over the same engine and the same document (V2-ARCHITECTURE.md).",
  "scripts": {
    "dev": "node ../engine/scripts/sync-presets.mjs && vite --port 5173 --strictPort",
    "build": "node ../engine/scripts/sync-presets.mjs && vite build && node scripts/copy-shared.mjs",
    "preview": "vite preview --port 5174",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@newkrok/three-particles": "file:../three-particles",
    "@newkrok/three-utils": "^2.0.2",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.3",
    "@types/three": "^0.182.0",
    "sass": "^1.104.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
