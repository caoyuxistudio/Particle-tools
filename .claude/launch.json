{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "packages/editor",
      "port": 8080
    },
    {
      "name": "editor-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "sirv",
        "public",
        "--dev",
        "--no-clear",
